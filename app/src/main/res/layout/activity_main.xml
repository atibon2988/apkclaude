<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTargetApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa chọn ứng dụng - vào Thiết lập để chọn"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bắt đầu" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dừng" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⚙ Thiết lập" />

    <!-- ==================== KHU VỰC DEBUG - TRẠNG THÁI THỰC TẾ ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#1A000000"
        android:padding="10dp"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvDebugSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tốc độ GPS hiện tại: -- km/h"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDebugCarState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trạng thái xe: chưa bắt đầu"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDebugCond1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Đã từng chạy &gt;15km/h: --"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDebugCond2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Tốc độ trong vùng kích hoạt: --"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDebugCond3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Không bị Pause: --"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDebugCond4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. App đích không hiển thị: --"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDebugTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trạng thái trigger tổng thể: --"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>
