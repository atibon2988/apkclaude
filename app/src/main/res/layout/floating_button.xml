<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="52dp"
    android:layout_height="52dp">

    <!-- Nền mờ trong suốt (alpha 0.4) - không che khuất tầm nhìn phía sau -->
    <View
        android:id="@+id/btnBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_floating_circle"
        android:alpha="0.4" />

    <ImageView
        android:id="@+id/btnIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_pause"
        android:alpha="0.9"
        app:tint="#FFFFFF" />

    <!-- Chấm nhỏ báo trạng thái: xanh = đang hoạt động, đỏ = đang Pause -->
    <View
        android:id="@+id/statusDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/bg_status_dot" />

</FrameLayout>
